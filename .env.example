# WattSwap environment. Copy to .env (`make env`). Never commit .env.
# Dev keys below are the PUBLIC Anvil defaults — local use only, worthless on any real network.

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=wattswap
POSTGRES_PASSWORD=wattswap_dev_password
POSTGRES_DB=wattswap
POSTGRES_PORT=5432

# --- Redis ----------------------------------------------------------------
REDIS_PORT=6379

# --- Anvil (local chain) --------------------------------------------------
ANVIL_PORT=8545
CHAIN_ID=31337
ANVIL_BLOCK_TIME=1

# --- API ------------------------------------------------------------------
API_PORT=8000
API_ENV=development                  # development | test | production. UNSET MEANS PRODUCTION (strict secrets, no missing-Origin /ws clients); local dev sets development explicitly
API_LOG_LEVEL=INFO
API_CORS_ORIGINS=http://localhost:3000   # comma-separated allow-list
# Host-side URLs (used by `uv run` / tests). Compose overrides hosts for containers.
DATABASE_URL=postgresql+asyncpg://wattswap:wattswap_dev_password@localhost:5432/wattswap
REDIS_URL=redis://localhost:6379/0
RPC_URL=http://localhost:8545

# Role keys (dev only; production would use a KMS/HSM — see docs/threat-model.md in Phase 1+)
# Anvil account #1, #2, #3
RELAYER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
ORACLE_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
PRICER_PRIVATE_KEY=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6
# Anvil account #4. MUST be a different address from the oracle/relayer/pricer keys: the API
# refuses to boot if any two role keys resolve to the same address.
REGISTRAR_PRIVATE_KEY=0x47e179ec197488593b187f80a00eb0da91f1b9d0b13f8733639f19c30a34926a

# --- Auth (SIWE -> JWT in an httpOnly, Secure, SameSite=Lax cookie) ---------------
# Required (>= 32 random chars) when API_ENV=production. Generate: openssl rand -hex 32
JWT_SECRET=dev-only-insecure-jwt-secret-change-me-0123456789
JWT_TTL_SECONDS=43200                 # 12h; logout revokes the token via a Redis denylist
SIWE_DOMAIN=localhost:3000            # must equal the domain in the wallet's SIWE message
# Comma-separated wallet addresses that get the admin role on login
ADMIN_ADDRESSES=

# --- Meter pipeline ---------------------------------------------------------------
READING_INTERVAL_SECONDS=900          # default interval the simulator reports (API validates each reading's own length)
MINT_CONFIRMATIONS=1
MINT_TX_TIMEOUT_SECONDS=60         # then the stuck mint tx is replaced with a higher fee
MINT_MAX_ATTEMPTS=5
MINT_BACKOFF_BASE_SECONDS=1        # infrastructure errors (RPC, nonce, gas) retry forever,
MINT_BACKOFF_MAX_SECONDS=60        # backing off exponentially up to this cap
SIM_DEMO_SECONDS=20                # meter-sim demo: real seconds per simulated interval

# --- Contract deployment (Foundry scripts; see contracts/script/Deploy.s.sol) ---------
# Deployer / DEFAULT_ADMIN of every contract. Local: Anvil account #0 (see `make deploy-local`).
# Sepolia: use a fresh throwaway key funded with Sepolia ETH. NEVER reuse a mainnet key.
PRIVATE_KEY=
# Role holders; each defaults to the deployer address when unset.
RELAYER_ADDRESS=
MINTER_ADDRESS=
PRICER_ADDRESS=
REGISTRAR_ADDRESS=
TREASURY_ADDRESS=
# Protocol fee and execution-price band (basis points). Also admin-settable on-chain.
FEE_BPS=100
BAND_BPS=500
# Sepolia only (Phase 8)
SEPOLIA_RPC_URL=
ETHERSCAN_API_KEY=

# --- Web ------------------------------------------------------------------
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Browser-side chain config (baked in at build time; the contract addresses come from packages/shared).
# NEXT_PUBLIC_CHAIN_ID must equal CHAIN_ID above (31337 = local Anvil, 11155111 = Sepolia).
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545        # the browser reads balances straight from this RPC
# Optional. Without it injected wallets (MetaMask, Rabby, Brave) work; mobile/WalletConnect wallets are hidden.
# Free project id from https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=


# --- Pricing engine (Phase 3) -----------------------------------------------------
PRICING_ENABLED=true
PRICING_EMBEDDED=true                 # false: run `make pricing` (python -m app.pricing.run) as its own process
PRICING_TICK_SECONDS=15               # the service refuses to boot if this breaks the limiter/breaker rule
WEATHER_POLL_SECONDS=600              # >= 300; one batched Open-Meteo request per poll covers every cell
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
PRICING_CLOCK_MODE=real               # real | follow_readings (demo: follow the accelerated simulator)
CLOCK_FOLLOW_WINDOW_SECONDS=120
PRICING_INVENTORY_SOURCE=auto         # auto | held | open_sells
ORACLE_PUSH_THRESHOLD_BPS=50
ORACLE_PUSH_HEARTBEAT_SECONDS=120
ORACLE_PUSH_MIN_INTERVAL_SECONDS=30

# --- Trading: order book, matcher, relayer, listener (Phase 4) ---------------------
# RELAYER_PRIVATE_KEY (above) must hold RELAYER_ROLE on the exchange; the API refuses to start
# trading otherwise. Dev only: production would use a KMS/HSM.
TRADING_ENABLED=true
TRADING_EMBEDDED=true                 # false: run `make trading` (python -m app.trading.run) as its own process
MIN_ORDER_WH=100                      # 0.1 kWh; smaller orders are rejected
MIN_FILL_WH=100                       # a leftover below this is closed ("dust_remainder")
MIN_FILL_COST=1000                    # mUSDC base units; a fill that costs less is never submitted
MIN_LIMIT_PRICE=1000                  # mUSDC base units per kWh (sanity bounds on a limit price)
MAX_LIMIT_PRICE=100000000
MIN_ORDER_LIFE_SECONDS=60             # plus EXPIRY_MARGIN_SECONDS: must outlive submit + mining
MAX_ORDER_LIFE_SECONDS=604800
EXPIRY_MARGIN_SECONDS=90
MAX_OPEN_ORDERS_PER_MAKER=50
RATE_LIMIT_ORDERS=30                  # order placements per address per RATE_LIMIT_WINDOW_SECONDS
MATCH_POLL_MS=500
QUOTE_SAFETY_MARGIN_SECONDS=60        # a quote needs this much validity left when signed (oracle maxStaleness is 300 s)
BAND_SAFETY_PCT=90                    # share of the on-chain execution band the matcher may use
SETTLE_HOLD_RETRY_SECONDS=5            # gas above the ceiling: hold and retry (the pair is released if its quote would go stale)
SETTLE_MAX_IN_FLIGHT=4                # concurrent submitted settlements (one nonce each)
SETTLE_MAX_ATTEMPTS=5                 # quote-related retries before a pair is released
SETTLE_BUMP_AFTER_SECONDS=20          # unmined tx is replaced at the same nonce: higher fee + fresh quote
PAIR_COOLDOWN_SECONDS=30              # released pairs wait this long, doubling each time ...
PAIR_COOLDOWN_MAX_SECONDS=600         # ... up to this cap
FUNDING_SWEEP_SECONDS=20              # every maker with open orders is re-checked (balance AND allowance)
LISTENER_CONFIRMATIONS=1              # blocks before an event is applied; use 6 on Sepolia
LISTENER_START_BLOCK=0                # set to the exchange deployment block on Sepolia
LISTENER_REORG_WINDOW=64
RECONCILE_SECONDS=120

# --- Gas-price ceiling (every transaction the API sends: mint, settle, oracle) ---------
MAX_FEE_PER_GAS_GWEI=100              # network price above this => hold the tx, never send; bumps are clamped to it
MAX_PRIORITY_FEE_GWEI=5

# --- WebSocket gateway (/ws) ------------------------------------------------------------
# Handshake Origin must match API_CORS_ORIGINS or WS_EXTRA_ORIGINS exactly (comma-separated). Foreign origin => HTTP 403.
WS_EXTRA_ORIGINS=
# Production: app and API must share a registrable domain (app.example.com + api.example.com) so the SameSite=Lax
# session cookie is sent on fetch and on the /ws handshake. Host-only cookie by default; set the Domain only if
# another subdomain must receive it. See docs/adr/009-realtime-gateway.md.
SESSION_COOKIE_DOMAIN=
WS_MAX_SUBSCRIPTIONS=20               # channels per connection (error frame beyond this)
WS_MAX_MESSAGE_BYTES=4096             # inbound frame size; larger => close 4413
WS_RATE_PER_WINDOW=20                 # sustained inbound messages per window ...
WS_RATE_WINDOW_SECONDS=10             # ... of this length
WS_RATE_BURST=40                      # bucket size; 3 breaches (WS_RATE_STRIKES) => close 4429
WS_RATE_STRIKES=3
WS_MAX_CONN_PER_IP=20                 # raise for load tests (make ws-load needs >= the client count)
WS_MAX_CONN_PER_ADDRESS=10
WS_SEND_QUEUE=256                     # per-socket queue; overflow or a stalled send => close 4409
WS_SEND_TIMEOUT_SECONDS=10
WS_PING_SECONDS=20                    # server JSON ping; closed after 2 silent intervals (4408)
WS_DENYLIST_POLL_SECONDS=30           # backstop re-check of logged-out sessions
WS_RESUME_MAX_MESSAGES=1000           # replay cap per channel on resume; beyond it the client re-snapshots
# Retained stream windows used for resume (count / age)
WS_RETAIN_PUBLIC_LEN=5000
WS_RETAIN_PUBLIC_AGE_SECONDS=600
WS_RETAIN_USER_LEN=1000
WS_RETAIN_USER_AGE_SECONDS=1800
WS_RETAIN_PRICE_LEN=500
WS_RETAIN_PRICE_AGE_SECONDS=3600

WS_LOADTEST_ENABLED=false             # dev only: allows synthetic loadtest:{name} channels for `make ws-load` (refused when API_ENV=production)
